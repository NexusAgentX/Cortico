{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // bin/cortico.mjs 是纯 JS(它得在 node_modules 存在之前就跑得起来,所以不能过 tsx)。
    // 它照样受检:文件头有 `// @ts-check`,类型写在 JSDoc 里。
    "allowJs": true,
    "checkJs": true,
    // 仓内 bot 包与扩展写同一种 import(`cortico/<src 下路径>`):搬出去成扩展包时代码零改。
    // 运行时由 src/extensions/runtime.ts 的模块钩子解析(tsx 也认这份 paths),vitest 用同形 alias。
    "paths": { "cortico/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "bots/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "templates/**/*.ts", "bin/**/*.mjs"],
  // 浏览器端源码由 tsconfig.web.json 用 DOM lib 单独 check。这里排掉它们,否则
  // 会拿 Node 的 lib 去 check DOM 代码。exclude 只影响初始文件表——被 Node 侧
  // import 到的仍然照常检查,所以服务端也 import 的 shared/console-protocol.ts
  // 不会漏检(它本来就不许碰 DOM)。
  "exclude": [
    "node_modules",
    "dist",
    "src/web/client/**",
    "src/providers/*/console/client.ts",
    "src/providers/*/console/*-panel.ts",
    "src/web/shared/**",
    // 跑在 jsdom 上的测试同理:它直接摸 document/HTMLElement,归 web 那份 check
    "tests/web/feature-prompts.test.ts",
    "tests/web/feature-firstturn.test.ts",
    "tests/web/feature-providers.test.ts",
    "tests/web/feature-extensions.test.ts",
    "src/worlds/*/console/**",
    "bots/*/console/**"
  ]
}
